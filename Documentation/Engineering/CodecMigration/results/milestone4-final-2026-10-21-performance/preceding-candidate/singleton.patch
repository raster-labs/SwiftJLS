+        }
+        let small = try ResourceLimits(maximumDecodedBytes: 3)
+        #expect(throws: CodecError(.resourceLimitExceeded, "Decoded storage limit exceeded.")) {
+            _ = try ImageDescriptor(width: 1, height: 1, planes: [first], limits: small)
+        }
+    }
