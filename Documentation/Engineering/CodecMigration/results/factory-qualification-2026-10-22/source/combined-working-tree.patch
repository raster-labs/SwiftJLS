+            guard rawBytes.count == byteCount else {
+                throw CodecError(.storageUnavailable, "Provider returned inconsistent capacity.")
+            }
+            try body(rawBytes)
+        }
+        try Task.checkCancellation()
+        return SealedImageStorage(bytes: bytes, allocationID: allocationID)
+    }
