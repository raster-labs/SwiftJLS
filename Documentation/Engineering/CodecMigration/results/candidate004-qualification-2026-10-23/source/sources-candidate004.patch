+                (UInt64(1) << UInt64(b)) &- 1,
+                ~((UInt64(1) << UInt64(b)) &- 1),
+                UInt64(1) << UInt64(b - 1),
+                UInt64(1) << UInt64(b),
+            ]
+            for x in boundaryPatterns {
+                let masked = (x & ((UInt64(1) << UInt64(b)) &- 1)) << UInt64(64 - b)
